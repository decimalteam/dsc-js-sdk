{
  "name": "dsc-js-sdk",
  "version": "3.0.0",
  "description": "JavaScript SDK for Decimal Smart Chain (EVM): contracts, multisig, subgraph and IPFS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "webpack --env development --watch",
    "build": "webpack --env production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test:testnet": "jest --runInBand --testMatch \"<rootDir>/test/testnet/**/*.test.ts\""
  },
  "keywords": [
    "decimal",
    "dsc",
    "evm",
    "sdk",
    "ethers"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bech32": "^2.0.0",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-node-externals": "^3.0.0"
  }
}
